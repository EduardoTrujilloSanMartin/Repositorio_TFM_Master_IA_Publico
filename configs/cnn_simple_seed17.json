{
  "experiment_name": "cnn_simple_weighted",
  "architecture": {
    "input_channels": 3,
    "channels": [32, 64, 128, 256],
    "kernel_size": 3,
    "padding": 1,
    "batch_normalization": true,
    "activation": "ReLU",
    "pooling": "MaxPool2d_2x2",
    "global_pooling": "AdaptiveAvgPool2d_1x1",
    "dropout": 0.3,
    "num_classes": 7,
    "initialization": "PyTorch_default_random"
  },
  "data": {
    "train_manifest": "data/manifests/ham10000_v1_seed2026/train.csv",
    "selection_manifest": "data/manifests/ham10000_v1_seed2026/selection.csv",
    "partition_seed": 2026,
    "class_order": ["akiec", "bcc", "bkl", "df", "mel", "nv", "vasc"],
    "input_size": [224, 224],
    "interpolation": "bilinear",
    "antialias": true,
    "train_augmentation": {
      "horizontal_flip_probability": 0.5,
      "vertical_flip_probability": 0.5,
      "right_angle_rotation_degrees": [0, 90, 180, 270],
      "right_angle_rotation_probabilities": [0.25, 0.25, 0.25, 0.25]
    },
    "normalization_mean": [0.485, 0.456, 0.406],
    "normalization_std": [0.229, 0.224, 0.225]
  },
  "training": {
    "seed": 17,
    "batch_size": 32,
    "max_epochs": 30,
    "loss": "weighted_cross_entropy",
    "class_weight_formula": "N_train / (7 * class_frequency_train)",
    "optimizer": "AdamW",
    "learning_rate": 0.001,
    "betas": [0.9, 0.999],
    "epsilon": 1e-8,
    "weight_decay": 0.0001,
    "early_stopping": {
      "active_from_epoch": 6,
      "patience": 7,
      "metric": "selection_f1_macro",
      "mode": "max"
    },
    "best_checkpoint_tiebreak": [
      "higher_selection_f1_macro",
      "lower_selection_unweighted_loss",
      "earlier_epoch"
    ],
    "automatic_mixed_precision": false,
    "num_workers": 4,
    "deterministic_algorithms": true
  },
  "scope": {
    "allowed_partitions": ["train", "selection"],
    "calibration_used": false,
    "test_used": false
  }
}
